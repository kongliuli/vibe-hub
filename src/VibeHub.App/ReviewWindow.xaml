<Window x:Class="VibeHub.App.ReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="审阅队列 — Distill"
        Height="560" Width="820"
        Background="#141414" Foreground="#e8e8e8">
  <Grid Margin="12">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="280"/>
      <ColumnDefinition Width="12"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>
    <DockPanel Grid.Column="0">
      <TextBlock DockPanel.Dock="Top" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"
                 Text="Pending / 全部"/>
      <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
        <Button Content="刷新" Click="Refresh_OnClick" Margin="0,0,6,0"/>
        <CheckBox x:Name="PendingOnlyBox" Content="仅 Pending" IsChecked="True"
                  Foreground="#ccc" VerticalAlignment="Center" Checked="Filter_OnChanged" Unchecked="Filter_OnChanged"/>
      </StackPanel>
      <ListBox x:Name="ArtifactList" DisplayMemberPath="Display"
               SelectionChanged="ArtifactList_OnSelectionChanged"
               Background="#1a1a1a" Foreground="#e8e8e8" BorderBrush="#333"/>
    </DockPanel>
    <DockPanel Grid.Column="2">
      <TextBlock x:Name="MetaText" DockPanel.Dock="Top" Foreground="#888" Margin="0,0,0,8" TextWrapping="Wrap"/>
      <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
        <Button Content="批准 → vault" Click="Approve_OnClick" Margin="0,0,8,0" Padding="12,6"/>
        <Button Content="拒绝" Click="Reject_OnClick" Padding="12,6"/>
      </StackPanel>
      <TextBox x:Name="ContentBox" AcceptsReturn="True" TextWrapping="Wrap"
               VerticalScrollBarVisibility="Auto" Background="#1c1c1c" Foreground="#eee"
               BorderBrush="#444" FontFamily="Consolas" FontSize="13"/>
    </DockPanel>
  </Grid>
</Window>
